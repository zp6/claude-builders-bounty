{
  "name": "weekly-dev-summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "daysOfWeek",
              "daysOfWeek": [
                5
              ]
            },
            {
              "field": "hours",
              "hours": [
                17
              ]
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Every Friday 5PM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "={{ $env.GITHUB_API_URL || 'https://api.github.com' }}/repos/{{ $env.GITHUB_REPO }}/commits?since={{ $now.minus({days:7}).toISO() }}&per_page=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "fullResponse": false
            }
          }
        }
      },
      "id": "fetch-commits",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0],
      "credentials": {
        "httpHeaderAuth": {
          "id": "GITHUB_TOKEN_CRED_ID",
          "name": "GitHub Token"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $env.GITHUB_API_URL || 'https://api.github.com' }}/repos/{{ $env.GITHUB_REPO }}/issues?state=closed&since={{ $now.minus({days:7}).toISO() }}&per_page=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "fullResponse": false
            }
          }
        }
      },
      "id": "fetch-issues",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "GITHUB_TOKEN_CRED_ID",
          "name": "GitHub Token"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $env.GITHUB_API_URL || 'https://api.github.com' }}/repos/{{ $env.GITHUB_REPO }}/pulls?state=closed&per_page=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "fullResponse": false
            }
          }
        }
      },
      "id": "fetch-prs",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 400],
      "credentials": {
        "httpHeaderAuth": {
          "id": "GITHUB_TOKEN_CRED_ID",
          "name": "GitHub Token"
        }
      }
    },
    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "mergeByPosition",
        "options": {}
      },
      "id": "merge-data",
      "name": "Merge All Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [440, 200]
    },
    {
      "parameters": {
        "jsCode": "// Prepare structured data for Claude\nconst commits = $input.first().json.commits || [];\nconst issues = $input.first().json.issues || [];\nconst prs = $input.first().json.prs || [];\n\n// Filter PRs to only merged\nconst mergedPRs = prs.filter(pr => pr.merged_at !== null);\n\nconst lang = $env.LANGUAGE || 'EN';\nconst repo = $env.GITHUB_REPO || 'unknown';\nconst weekStart = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];\nconst weekEnd = new Date().toISOString().split('T')[0];\n\n// Build data summary\nconst commitList = commits.map(c => `- ${c.commit.message.split('\\n')[0]} (${c.commit.author.name})`).join('\\n');\nconst issueList = issues.map(i => `- #${i.number} ${i.title} [${i.state}]`).join('\\n');\nconst prList = mergedPRs.map(p => `- #${p.number} ${p.title} (@${p.user.login})`).join('\\n');\n\nconst prompt = lang === 'FR' \n  ? `Génère un résumé narratif de l'activité hebdomadaire du dépôt GitHub ${repo} pour la semaine du ${weekStart} au ${weekEnd}.\\n\\nCommits (${commits.length}):\\n${commitList || 'Aucun'}\\n\\nIssues fermées (${issues.length}):\\n${issueList || 'Aucune'}\\n\\nPRs fusionnées (${mergedPRs.length}):\\n${prList || 'Aucune'}\\n\\nFormat: résumé en 3-5 paragraphes, ton professionnel mais accessible. Mets en avant les contributions majeures et les tendances.`\n  : `Generate a narrative weekly summary for the GitHub repo ${repo} for the week of ${weekStart} to ${weekEnd}.\\n\\nCommits (${commits.length}):\\n${commitList || 'None'}\\n\\nClosed Issues (${issues.length}):\\n${issueList || 'None'}\\n\\nMerged PRs (${mergedPRs.length}):\\n${prList || 'None'}\\n\\nFormat: 3-5 paragraph narrative summary. Professional but approachable tone. Highlight major contributions, trends, and milestones. Start with a high-level overview, then dive into specifics.`;\n\nreturn [{ json: { prompt, repo, weekStart, weekEnd, stats: { commits: commits.length, issues: issues.length, prs: mergedPRs.length } } }];"
      },
      "id": "prepare-prompt",
      "name": "Prepare Claude Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 200]
    },
    {
      "parameters": {
        "model": "claude-sonnet-4-20250514",
        "options": {
          "temperature": 0.5
        }
      },
      "id": "call-claude",
      "name": "Generate Summary (Claude)",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1,
      "position": [880, 200],
      "credentials": {
        "anthropicApi": {
          "id": "ANTHROPIC_CRED_ID",
          "name": "Anthropic API"
        }
      }
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "format-output",
      "name": "Format Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "={{ $env.DELIVERY_METHOD || 'webhook' }}",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "webhook-mode",
              "leftValue": "={{ $env.DELIVERY_METHOD || 'webhook' }}",
              "rightValue": "webhook",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "email-mode",
              "leftValue": "={{ $env.DELIVERY_METHOD }}",
              "rightValue": "email",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "route-delivery",
      "name": "Route Delivery",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1320, 200]
    },
    {
      "parameters": {
        "url": "={{ $env.WEBHOOK_URL }}",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"content\": \"## 📋 Weekly Dev Summary — {{ $json.repo }}\\n**Week**: {{ $json.weekStart }} → {{ $json.weekEnd }}\\n**Stats**: {{ $json.stats.commits }} commits | {{ $json.stats.issues }} issues closed | {{ $json.stats.prs }} PRs merged\\n\\n{{ $json.summary }}\"}",
        "options": {}
      },
      "id": "send-webhook",
      "name": "Send to Discord/Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 100]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.EMAIL_FROM }}",
        "toEmail": "={{ $env.EMAIL_TO }}",
        "subject": "=📋 Weekly Dev Summary — {{ $json.repo }} ({{ $json.weekStart }} → {{ $json.weekEnd }})",
        "text": "={{ $json.summary }}",
        "options": {}
      },
      "id": "send-email",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1540, 300]
    }
  ],
  "connections": {
    "Every Friday 5PM": {
      "main": [
        [
          { "node": "Fetch Commits", "type": "main", "index": 0 },
          { "node": "Fetch Closed Issues", "type": "main", "index": 0 },
          { "node": "Fetch Merged PRs", "type": "main", "index": 0 }
        ]
      ]
    },
    "Fetch Commits": {
      "main": [[{ "node": "Merge All Data", "type": "main", "index": 0 }]]
    },
    "Fetch Closed Issues": {
      "main": [[{ "node": "Merge All Data", "type": "main", "index": 0 }]]
    },
    "Fetch Merged PRs": {
      "main": [[{ "node": "Merge All Data", "type": "main", "index": 0 }]]
    },
    "Merge All Data": {
      "main": [[{ "node": "Prepare Claude Prompt", "type": "main", "index": 0 }]]
    },
    "Prepare Claude Prompt": {
      "main": [[{ "node": "Generate Summary (Claude)", "type": "main", "index": 0 }]]
    },
    "Generate Summary (Claude)": {
      "main": [[{ "node": "Format Summary", "type": "main", "index": 0 }]]
    },
    "Format Summary": {
      "main": [[{ "node": "Route Delivery", "type": "main", "index": 0 }]]
    },
    "Route Delivery": {
      "main": [
        [{ "node": "Send to Discord/Slack", "type": "main", "index": 0 }],
        [{ "node": "Send Email", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    { "name": "weekly-summary" },
    { "name": "claude" },
    { "name": "github" }
  ]
}
